# GEMINI_API_KEY: Required for Gemini AI API calls on the backend (Phase 2 & 5).
# Never prefix server-side secret keys with VITE_.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Base URL for the Python FastAPI backend (Phase 2+).
# Example: http://localhost:8000/api/v1
VITE_API_BASE_URL=""
